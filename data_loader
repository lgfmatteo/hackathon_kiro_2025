import pandas as pd


def load_datas() :
    '''
    Retourne deux listes : la première est une liste de liste de dictionnaires correspondant à chaque sommet, 
    la seconde est une liste de dictionnaires correspondant à chaque véhicule.
    Pour chaque instance la liste des sommets est triée selon window_start.
    '''

    instances = []

    # chargement des instances et tri sur la clé window start
    for s in ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10'] :
        df = pd.read_csv('instances/instance_' + s + '.csv')
        df = df.sort_values('window_start')
        instances.append(df.to_dict('records'))

    # chargement des véhicules 
    df = pd.read_csv('instances/vehicules.csv')    
    vehicules = df.to_dict('records')
    
    return instances, vehicules



