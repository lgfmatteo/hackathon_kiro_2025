import pandas as pd
import os
import glob
import json

def charger_et_preparer_instances(file_pattern: str = "instance_*.csv") -> dict:
    """
    Lit tous les fichiers d'instances, trie les commandes par 'window_start' 
    (département en tête) et convertit chaque instance en un dictionnaire 
    orienté colonnes.
    """
    instances_data = {}
    
    # Utilisation de glob pour trouver tous les fichiers
    instance_files = sorted(glob.glob(file_pattern))

    if not instance_files:
        print(f"Aucun fichier trouvé avec le modèle : {file_pattern}")
        return instances_data
    
    print(f"Fichiers d'instances détectés : {len(instance_files)}")
    
    for file_path in instance_files:
        try:
            file_name = os.path.basename(file_path)
            parts = file_name.split('_')
            instance_id = parts[-1].split('.')[0]
            
            print(f"Traitement du fichier : {file_name} (ID: {instance_id})...")
            
            df = pd.read_csv(file_path)
            
            # --- Étape de Préparation ---
            
            # 1. Trier par 'window_start' en plaçant la valeur NaN (du dépôt) en premier.
            # Cela garantit que le dépôt est le premier élément de toutes les listes.
            df_sorted = df.sort_values(
                by='window_start', 
                ascending=True, 
                na_position='first'
            ).reset_index(drop=True)
            
            # 2. Convertir le DataFrame trié en dictionnaire (colonne -> liste)
            # 'list' produit un dictionnaire avec {colonne: [v1, v2, ...]}
            data_dict = df_sorted.to_dict('list')
            
            instances_data[instance_id] = data_dict
            
        except Exception as e:
            print(f"Erreur lors de la lecture du fichier {file_path}: {e}")
            
    print("\nDonnées de toutes les instances traitées avec succès.")
    return instances_data

