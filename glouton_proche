import pandas as pd
import numpy as np
import math

# Constants
EARTH_RADIUS = 6.371e6
TWO_PI_OVER_360 = 2 * math.pi / 360
SECONDS_PER_DAY = 86400

s = '10' 

# Chargement des données
vehicles_df = pd.read_csv('instances/vehicles.csv')
instance_df = pd.read_csv('instances/instance_' + s + '.csv')
depot = instance_df[instance_df['id'] == 0].iloc[0]
orders = instance_df[instance_df['id'] != 0].to_dict('records')

phi_depot = depot['latitude']
lambd_depot = depot['longitude']

# =================== FONCTIONS DE CALCUL (Inchangées) ===================

def latlon_to_cartesian(phi_i, lambd_i, phi_y, lambd_y, phi0):
    delta_y = EARTH_RADIUS * TWO_PI_OVER_360 * (phi_y - phi_i)
    delta_x = EARTH_RADIUS * math.cos(TWO_PI_OVER_360 * phi0) * TWO_PI_OVER_360 * (lambd_y - lambd_i)
    return delta_x, delta_y

def manhattan_distance(phi_i, lambd_i, phi_j, lambd_j, phi0):
    delta_x, delta_y = latlon_to_cartesian(phi_i, lambd_i, phi_j, lambd_j, phi0)
    return abs(delta_x) + abs(delta_y)

def travel_time(departure_time_sec, phi_i, lambd_i, phi_j, lambd_j, speed, parking_time, alpha_coef, beta_coef, phi0):
    dist_manhattan = manhattan_distance(phi_i, lambd_i, phi_j, lambd_j, phi0)
    tau_ref = dist_manhattan / speed + parking_time
    omega = 2 * math.pi / SECONDS_PER_DAY
    gamma = 0
    for n in range(4):
        gamma += alpha_coef[n] * math.cos(n * omega * departure_time_sec) + beta_coef[n] * math.sin(n * omega * departure_time_sec)
    tau = tau_ref * gamma
    return tau

# =================== FONCTION DE FAISABILITÉ (Inchangée) ===================

def check_delivery_feasibility(
    current_time, phi_current, lambd_current, 
    order, 
    vehicle_capacity_remaining, vehicle_speed, parking_time, 
    alpha_coef, beta_coef, phi0
):
    if vehicle_capacity_remaining < order['order_weight']:
        return False, 0
    
    travel_time_duration = travel_time(
        current_time, phi_current, lambd_current, 
        order['latitude'], order['longitude'], 
        vehicle_speed, parking_time, alpha_coef, beta_coef, phi0
    )
    
    arrival_at_location = current_time + travel_time_duration
    service_start_time = max(arrival_at_location, order['window_start'])
    
    if service_start_time > order['window_end']:
        return False, 0
        
    departure_time = service_start_time + order['delivery_duration']
    
    return True, departure_time


# =================== HEURISTIQUE GLOUTONNE (Inchangée) ===================

def result(orders, vehicles_df, depot, phi_depot, lambd_depot):
    routes = []
    remaining_orders = set(range(len(orders)))
    
    while remaining_orders:
        total_weight = sum(orders[i]['order_weight'] for i in remaining_orders)
        
        vehicles_df_sorted = vehicles_df.sort_values('max_capacity')
        selected_vehicle = None
        
        for _, vehicle in vehicles_df_sorted.iterrows():
            if vehicle['max_capacity'] >= total_weight:
                selected_vehicle = vehicle
                break
        
        if selected_vehicle is None: #si jamais aucun camion ne peut tout contenir, on prend le plus gros
            selected_vehicle = vehicles_df_sorted.iloc[-1]
        
        route = {
            'family': int(selected_vehicle['family']),
            'orders_indices': [],
            'capacity_remaining': selected_vehicle['max_capacity'],
            'current_phi': phi_depot,
            'current_lambd': lambd_depot,
            'current_time': 0
        }
        
        alpha_coef = [
            selected_vehicle['fourier_cos_0'],
            selected_vehicle['fourier_cos_1'],
            selected_vehicle['fourier_cos_2'],
            selected_vehicle['fourier_cos_3']
        ]
        beta_coef = [
            selected_vehicle['fourier_sin_0'],
            selected_vehicle['fourier_sin_1'],
            selected_vehicle['fourier_sin_2'],
            selected_vehicle['fourier_sin_3']
        ]
        
        while True:
            best_order_idx = None
            best_distance = float('inf')
            best_departure_time = 0
            
            for order_idx in remaining_orders:
                order = orders[order_idx]
                
                is_feasible, departure_time = check_delivery_feasibility(
                    route['current_time'],
                    route['current_phi'],
                    route['current_lambd'],
                    order,
                    route['capacity_remaining'],
                    selected_vehicle['speed'],
                    selected_vehicle['parking_time'],
                    alpha_coef,
                    beta_coef,
                    phi_depot
                )
                
                if not is_feasible:
                    continue
                
                dist = manhattan_distance(
                    route['current_phi'],
                    route['current_lambd'],
                    order['latitude'],
                    order['longitude'],
                    phi_depot
                )
                
                if dist < best_distance:
                    best_distance = dist
                    best_order_idx = order_idx
                    best_departure_time = departure_time
            
            if best_order_idx is None:
                break
            
            order = orders[best_order_idx]
            
            route['orders_indices'].append(best_order_idx)
            route['capacity_remaining'] -= order['order_weight']
            route['current_phi'] = order['latitude']
            route['current_lambd'] = order['longitude']
            route['current_time'] = best_departure_time
            
            remaining_orders.remove(best_order_idx)
        
        if route['orders_indices']:
            routes.append(route)
        elif not remaining_orders:
            break
        elif not route['orders_indices'] and remaining_orders:
            print(f"ERREUR: Impossible de livrer les {len(remaining_orders)} commandes restantes.")
            break
    
    return routes

# =================== EXPORT CSV (Corrigé) ===================

def export_routes_csv(routes, orders, filename='routes.csv'):
    """
    Exporte les routes au format CSV requis
    """
    if not routes:
        print("Aucune route à exporter.")
        pd.DataFrame(columns=['family']).to_csv(filename, index=False, na_rep='')
        return

    max_orders = max(len(route['orders_indices']) for route in routes)
    
    data = []
    for route in routes:
        # On garde les conversions en int ici, c'est une bonne pratique
        row = {'family': int(route['family'])}
        for i, order_idx in enumerate(route['orders_indices'], start=1):
            order_id = int(orders[order_idx]['id'])
            row[f'order_{i}'] = order_id
        data.append(row)
    
    all_columns = ['family'] + [f'order_{i}' for i in range(1, max_orders + 1)]
    
    df = pd.DataFrame(data)
    df = df.reindex(columns=all_columns)
    
    # --- CORRECTION DÉFINITIVE ---
    
    # 1. Colonne 'family': C'est un entier simple (elle n'est jamais nulle)
    df['family'] = df['family'].astype(int)
    
    # 2. Colonnes 'order_...': 
    # On boucle sur toutes les colonnes d'ordre
    for i in range(1, max_orders + 1):
        col_name = f'order_{i}'
        # On utilise 'Int64' (avec I majuscule) qui supporte les entiers ET les nuls (NA)
        # sans convertir en float.
        df[col_name] = df[col_name].astype('Int64')
    
    # --- FIN DE LA CORRECTION ---

    # na_rep='' va maintenant écrire les 'NA' comme des cellules vides
    df.to_csv(filename, index=False, na_rep='')

# =================== EXÉCUTION ===================

routes = result(orders, vehicles_df, depot, phi_depot, lambd_depot)

output_filename = f'routes_{s}.csv'
export_routes_csv(routes, orders, output_filename)

print(f"Exportation terminée. {len(routes)} routes générées pour l'instance {s} dans {output_filename}.")